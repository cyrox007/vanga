[Unit]
Description=Vanga periodic model retraining
After=network-online.target vanga.service
Wants=network-online.target

[Service]
Type=oneshot
User=vanga
Group=vanga
WorkingDirectory=/opt/vanga
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
Environment=VANGA_ORCHESTRATION_LOCK=/opt/vanga/data/runtime/orchestration.lock
ExecStart=/opt/vanga/.venv/bin/python /opt/vanga/retrain_job.py
# После ds_update процесс inference обязан переоткрыть imdb.duckdb. ExecStopPost
# выполняется и при неудачном retrain, поэтому свежая БД не остаётся скрыта за
# старым DuckDB connection. Префикс '+' оставляет systemctl root-привилегии,
# хотя сам тяжёлый job выполняется от непривилегированного пользователя vanga.
ExecStopPost=+/usr/bin/systemctl restart vanga.service
Nice=15
CPUQuota=50%
MemoryHigh=1G
MemoryMax=1200M
MemorySwapMax=2G
OOMPolicy=stop
OOMScoreAdjust=500
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
