[Unit]
Description=Vanga periodic model retraining
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=vanga
Group=vanga
WorkingDirectory=/opt/vanga
Environment=PYTHONUNBUFFERED=1
Environment=MALLOC_ARENA_MAX=2
ExecStart=/opt/vanga/.venv/bin/python /opt/vanga/ds_update.py
ExecStart=/opt/vanga/.venv/bin/python /opt/vanga/traning.py
Nice=15
CPUQuota=100%
MemoryHigh=900M
MemoryMax=1200M
MemorySwapMax=2G
OOMPolicy=stop
OOMScoreAdjust=500
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h
